{
  "expo": {
    "name": "Hushh",
    "description": "Hushh - Where people feel heard",
    "slug": "hushh-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Hushh uses your location to find nearby groups.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.ashish221singh.hushhapp"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "usesCleartextTraffic": true,
      "permissions": [
        "POST_NOTIFICATIONS",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.ashish221singh.hushhapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "expo-font",
      [
        "expo-notifications",
        {
          "defaultChannel": "hushh-default"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Hushh uses your location to find nearby groups."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a4b1b252-c372-4939-b584-fcb852c84c37"
      }
    },
    "owner": "ashish221singh"
  }
}
